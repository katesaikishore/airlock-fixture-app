{
  "name": "airlock-fixture-app",
  "version": "1.0.0",
  "private": true,
  "description": "Small web app with deliberately seeded bugs, used as a target for Airlock QA acceptance tests. See SEEDED_BUGS.md.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server.js",
    "test": "node --test test/unit/*.test.js",
    "test:allowed": "node --test --test-skip-pattern=SEEDED test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/qa/a11y.js",
    "test:security": "node scripts/qa/security.js",
    "test:load": "node scripts/qa/load.js",
    "test:explore": "node scripts/qa/explore.js"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "axe-core": "4.10.2"
  }
}
